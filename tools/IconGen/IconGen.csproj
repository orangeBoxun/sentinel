<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- System.Drawing.Common ships inside the Windows Desktop runtime, so UseWindowsForms is the
         offline way to reach it — no NuGet package to restore. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds this as a global using, which makes Button/Point/Color ambiguous
         alongside System.Drawing. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
