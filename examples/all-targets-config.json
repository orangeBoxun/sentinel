{
  "Version": 1,
  "Targets": [
    {
      "Id": "codex",
      "DisplayName": "Codex（读正文·慢）",
      "ProcessNames": ["ChatGPT"],
      "Enabled": true,
      "Reader": { "ScanUrl": true, "ScanTitle": true, "ScanBody": true, "IntervalMs": 5000, "MaxBodyChars": 20000 },
      "Rules": [
        {
          "Id": "r-codex-body", "Name": "正文含「锁机」", "Enabled": true,
          "PolicyId": "p-minimize", "Priority": 10,
          "Match": { "Type": "Keyword", "Fields": ["Body"], "Patterns": ["锁机"], "CaseSensitive": false }
        }
      ]
    },
    {
      "Id": "harness",
      "DisplayName": "DeepSeek Harness（只读 URL·快）",
      "ProcessNames": ["DeepSeek Harness"],
      "Enabled": true,
      "Reader": { "ScanUrl": true, "ScanTitle": true, "ScanBody": false, "IntervalMs": 2000, "MaxBodyChars": 4096 },
      "Rules": [
        {
          "Id": "r-harness-url", "Name": "URL 含 bilibili", "Enabled": true,
          "PolicyId": "p-minimize", "Priority": 10,
          "Match": { "Type": "Keyword", "Fields": ["Url"], "Patterns": ["bilibili"], "CaseSensitive": false }
        }
      ]
    },
    {
      "Id": "edge",
      "DisplayName": "Edge（只读 URL·快）",
      "ProcessNames": ["msedge"],
      "Enabled": true,
      "Reader": { "ScanUrl": true, "ScanTitle": true, "ScanBody": false, "IntervalMs": 2000, "MaxBodyChars": 4096 },
      "Rules": [
        {
          "Id": "r-edge-url", "Name": "URL 含 deepseek", "Enabled": true,
          "PolicyId": "p-close", "Priority": 10,
          "Match": { "Type": "Keyword", "Fields": ["Url"], "Patterns": ["deepseek"], "CaseSensitive": false }
        }
      ]
    }
  ],
  "Policies": [
    {
      "Id": "p-minimize", "Name": "通知 3 秒后最小化",
      "Actions": ["Notify", "Minimize"], "GraceSeconds": 3, "CooldownSeconds": 30, "DebounceCount": 1
    },
    {
      "Id": "p-close", "Name": "通知 3 秒后关窗",
      "Actions": ["Notify", "Close"], "GraceSeconds": 3, "CooldownSeconds": 30, "DebounceCount": 1
    }
  ],
  "Schedules": [],
  "Protection": { "Enabled": false, "Mode": "None", "SecretHash": null, "DelaySeconds": 0 },
  "Logging": { "LogDirectory": "%TEMP%\\Sentinel\\logs", "LogBodyText": false, "LogUrlHash": true },
  "Ui": { "Locale": "zh-CN", "DryRun": true }
}
