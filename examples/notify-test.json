{
  "Version": 1,
  "Targets": [
    {
      "Id": "notify-test",
      "DisplayName": "通知测试",
      "ProcessNames": ["ChatGPT"],
      "Enabled": true,
      "Reader": { "ScanUrl": true, "ScanTitle": true, "ScanBody": false, "IntervalMs": 2000, "MaxBodyChars": 4096 },
      "Rules": [
        {
          "Id": "r-always",
          "Name": "正则 .+ 匹配标题（必然命中）",
          "Enabled": true,
          "PolicyId": "p-notify-only",
          "Priority": 10,
          "Match": { "Type": "Regex", "Fields": ["Title"], "Patterns": [".+"], "CaseSensitive": false }
        }
      ]
    }
  ],
  "Policies": [
    {
      "Id": "p-notify-only",
      "Name": "只通知（每 8 秒一次，方便观察）",
      "Actions": ["Notify"],
      "GraceSeconds": 0,
      "CooldownSeconds": 8,
      "DebounceCount": 1
    }
  ],
  "Schedules": [],
  "Protection": { "Enabled": false, "Mode": "None", "SecretHash": null, "DelaySeconds": 0 },
  "Logging": { "LogDirectory": "%TEMP%\\Sentinel\\logs", "LogBodyText": false, "LogUrlHash": true },
  "Ui": { "Locale": "zh-CN", "DryRun": false }
}
