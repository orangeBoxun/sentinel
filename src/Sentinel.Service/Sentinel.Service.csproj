<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Sentinel.Service-15ee24af-6517-44da-819a-3863da6887ba</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Core\Sentinel.Core.csproj" />
    <ProjectReference Include="..\Sentinel.Platform\Sentinel.Platform.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- SessionLauncher uses Win32 APIs; the service host itself does not need WPF. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- No UI, but this is the icon Task Manager and the Services list show for it. -->
    <ApplicationIcon>..\..\assets\sentinel.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
