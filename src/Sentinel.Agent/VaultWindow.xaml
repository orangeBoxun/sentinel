<Window x:Class="Sentinel.Agent.VaultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="密码保险箱" Height="720" Width="960" MinHeight="480" MinWidth="760" Icon="Assets/sentinel.ico" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 和主窗口同一圈回纹饰带，两个窗口看起来才是一套的。 -->
        <Border Grid.Row="0" Height="12" Background="{StaticResource KnotBand}" />

        <Grid Grid.Row="1" Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 防护状态。整窗的结论就在这一条上，所以它单独占一行，而不是混在内容里。 -->
        <Border Grid.Row="0" Background="{StaticResource Fill}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="正在检查防护状态…" />
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">

            <!-- ──────────────── 尚未建立 -->
            <ScrollViewer x:Name="SetupPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="建立密码保险箱" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" Text="放任何文件或文件夹。内容加密保存，打开要输密码A；监护码B 交给别人拿着。" />

                    <!-- 卡片流式排布：窗口宽了就并排，窄了自动折回一列。
                         之前是一列到底加一个最大宽度，全屏时右边整片空着 —— 那不叫自适应。 -->
                    <WrapPanel Margin="0,20,0,0">

                    <Grid Margin="0,0,18,18" Width="400"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="它是怎么保护的" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="内容用一把随机密钥加密，密钥分别由两样东西包着：" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="· 密码A —— 你自己用，平时打开保险箱靠它。" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="· 监护码B —— 抄给一个你信得过的人，你自己不留。" />

                            <Border Background="{StaticResource WarningSurface}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Warning}" Text="如果防护被拆掉（卸载、删除服务、删掉看门狗），密码A 会立刻失效，只有监护码B 还能打开。所以监护码必须真的交出去 —— 留在自己手上的话，这套机制什么也没挡住。" />
                            </Border>
                        </StackPanel>
                    </Border></Grid>

                    <Grid Margin="0,0,18,18" Width="400"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="先设一个密码A" />

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,8" Text="密码A（至少 8 位，平时存在你的手机里）" />
                            <PasswordBox x:Name="SetupPassword" />

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,8" Text="再输一遍" />
                            <PasswordBox x:Name="SetupConfirmPassword" />

                            <Button Content="生成监护码" Style="{StaticResource PrimaryIconButton}" Tag="{StaticResource IconRefresh}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="GenerateGuardian_Click" />
                        </StackPanel>
                    </Border></Grid>

                    <Grid x:Name="GuardianConfirmPanel" Margin="0,0,18,18" Width="400" Visibility="Collapsed"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="监护码B —— 抄下来，现在就交给监护人" />
                            <!-- 监护码要用大字显示，固定 36 高会裁掉；Height="Auto" 抵消基础样式里的单行高度。 -->
                            <TextBox x:Name="GuardianCodeText" IsReadOnly="True" Margin="0,12,0,0" FontFamily="{StaticResource MonoFont}" FontSize="17" Padding="12,10" Height="Auto" MinHeight="52" TextWrapping="Wrap" TextAlignment="Center" />

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" Text="抄完以后在这里敲一遍确认（大小写和横线随便，认错的地方会自动纠正）。这一步是唯一能验证纸上那份没抄错的时机 —— 等出事那天再发现就来不及了。" />
                            <TextBox x:Name="GuardianConfirmBox" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}" />

                            <Button Style="{StaticResource PrimaryIconButton}" Tag="{StaticResource IconCheck}" Content="创建保险箱" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Create_Click" />
                        </StackPanel>
                    </Border></Grid>

                    <Grid Margin="0,0,18,18" Width="400"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="换机器，或者程序被清掉之后" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,9,0,0" Text="从这里把之前的保险箱放回来。" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconRefresh}" Content="从备份恢复…" HorizontalAlignment="Left" Margin="0,16,0,0" Click="RestoreBackup_Click" />
                        </StackPanel>
                    </Border></Grid>

                    </WrapPanel>

                    <TextBlock x:Name="SetupError" Style="{StaticResource ErrorText}" Margin="0,0,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ──────────────── 已上锁 -->
            <!--
                外层的 ScrollViewer 必须跟着里面的面板一起隐藏。

                它们四个是同一个格子里叠着的。只隐藏里面的 StackPanel 的话，外面这层 ScrollViewer
                仍然是 Visible、仍然铺满整格，而且压在「尚未建立」上面 —— 一个空的滚动区不参与滚动，
                却把滚轮吃掉了，于是建立保险箱那一页怎么滚都不动。
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Visibility, ElementName=LockedPanel}">
                <StackPanel x:Name="LockedPanel" MaxWidth="1000" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="保险箱是锁着的" />

                    <Grid Margin="0,20,0,0"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,8" Text="密码A" />
                            <PasswordBox x:Name="UnlockPassword" />
                            <Button Style="{StaticResource PrimaryIconButton}" Tag="{StaticResource IconLock}" Content="打开" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Unlock_Click" />

                            <Expander Margin="0,20,0,0" Header="用监护码打开（防护被拆之后才需要）">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="监护码在你交给的那个人手上。用它打开不算绕过 —— 那正是这套机制要你走的门。" />
                                    <TextBox x:Name="UnlockCode" Margin="0,12,0,0" FontFamily="{StaticResource MonoFont}" />
                                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCheck}" Content="用监护码打开" HorizontalAlignment="Left" Margin="0,12,0,0" Click="UnlockWithCode_Click" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border></Grid>

                    <Grid Margin="0,14,0,0"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="文件打不开了" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="密码打不开、或者觉得文件坏掉了，可以从备份放回来。注意：恢复不会解除封印。" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconRefresh}" Content="从备份恢复…" HorizontalAlignment="Left" Margin="0,14,0,0" Click="RestoreBackup_Click" />
                        </StackPanel>
                    </Border></Grid>

                    <TextBlock x:Name="UnlockError" Style="{StaticResource ErrorText}" Margin="0,14,0,0" />

                    <!-- 唯一的出路：密码和监护码都打不开时，保险箱既开不了、也建不了新的 -->
                    <Grid Margin="0,14,0,0"><Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="{StaticResource HairlineStrong}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="密码和监护码都打不开它了？" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="清空之后内容会全部消失，且无法找回。这是最后一步。" />
                            <Button Style="{StaticResource DangerIconButton}" Tag="{StaticResource IconTrash}" Content="清空保险箱，重新开始" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetVault_Click" />
                        </StackPanel>
                    </Border></Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ──────────────── 已封印 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Visibility, ElementName=SealedPanel}">
                <StackPanel x:Name="SealedPanel" MaxWidth="1000" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Foreground="{StaticResource Danger}" Text="保险箱已封印" />

                    <Grid Margin="0,20,0,0"><Border Style="{StaticResource Card}" BorderBrush="{StaticResource DangerBorder}" Background="{StaticResource DangerSurface}">
                        <StackPanel>
                            <TextBlock x:Name="SealedReasonText" TextWrapping="Wrap" LineHeight="21" />
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21" Text="你的密码A 已经作废了，文件本身一个都没动。拿监护码可以完整地打开，然后把密码和监护码重新设一遍。" />
                        </StackPanel>
                    </Border></Grid>

                    <Grid Margin="0,14,0,0"><Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,8" Text="监护码B" />
                            <TextBox x:Name="SealedCode" FontFamily="{StaticResource MonoFont}" />
                            <Button Style="{StaticResource PrimaryIconButton}" Tag="{StaticResource IconCheck}" Content="用监护码打开" HorizontalAlignment="Left" Margin="0,14,0,0" Click="UnlockWithCode_Click" />
                        </StackPanel>
                    </Border></Grid>

                    <TextBlock x:Name="SealedError" Style="{StaticResource ErrorText}" Margin="0,14,0,0" />

                    <Grid Margin="0,14,0,0"><Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="{StaticResource HairlineStrong}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="监护人的那份码也拿不到了？" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="清空之后内容会全部消失，且无法找回。这是最后一步。" />
                            <Button Style="{StaticResource DangerIconButton}" Tag="{StaticResource IconTrash}" Content="清空保险箱，重新开始" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetVault_Click" />
                        </StackPanel>
                    </Border></Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ──────────────── 已打开 -->
            <Grid x:Name="UnlockedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 用监护码进来之后，提示重设 -->
                <Border x:Name="RecoveryBanner" Grid.Row="0" Background="{StaticResource WarningSurface}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Warning}" Text="你正在用监护码访问。" />
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="21"
                                   Text="设一个新密码就解除封印。监护码保持现在这个 —— 要换的话，下面有「换监护码」。（封印把密码那道门删掉了，所以密码得重新包一遍；你可以填回原来那个。）" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,8" Text="新密码A" />
                        <PasswordBox x:Name="RecoverPassword" />

                        <Button Content="设新密码并解除封印" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SetPasswordAndUnseal_Click" />

                        <TextBlock x:Name="RecoveryError" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPlus}" Content="放入文件" Click="AddFiles_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}" Content="放入文件夹" Click="AddFolder_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}" Content="取出到…" Click="Extract_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}" Content="删除" Click="Remove_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCopy}" Content="导出备份…" Click="ExportBackup_Click" Margin="0,0,8,8" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconLock}" Content="锁定" Click="Lock_Click" Margin="0,0,8,8" />
                </WrapPanel>

                <!--
                    用 ListBox + DataTemplate，而不是 ListView + GridView。

                    GridViewColumn 的宽度只能是固定数字，没有 * —— 窗口一宽，右边就留一条空白，
                    列也不会跟着长。"位置"这一列才是需要吃掉剩余宽度的那个，所以自己写一个 Grid。
                -->
                <Grid Grid.Row="2"><Border Style="{StaticResource Card}" Padding="14,10,14,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Micro}" Text="位置" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Micro}" Text="大小" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Micro}" Text="放入时间" />
                        </Grid>

                        <Separator DockPanel.Dock="Top" Margin="0,0,0,6" />

                        <ListBox x:Name="EntryList" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding AddedAt}" Foreground="{StaticResource TextTertiary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border></Grid>

                <TextBlock x:Name="VaultMessage" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" />

                <Expander Grid.Row="4" Margin="0,10,0,0" Header="修改密码 / 改监护码">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"><Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="密码A" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" Text="改完立刻生效。监护码不受影响。" />
                                <PasswordBox x:Name="NewPasswordBox" Margin="0,14,0,0" />
                                <PasswordBox x:Name="NewPasswordConfirmBox" Margin="0,8,0,0" />
                                <Button Content="改密码" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ChangePassword_Click" />
                                <TextBlock x:Name="ChangePasswordMessage" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border></Grid>

                        <Grid Grid.Column="2"><Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="监护码B" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0" Text="要改必须先输入现在这份 —— 否则你可以把监护人的那份换成自己知道的，那道门就白设了。" />
                                <TextBox x:Name="CurrentGuardianBox" Margin="0,14,0,0" FontFamily="{StaticResource MonoFont}" />
                                <Button Content="生成新的监护码" HorizontalAlignment="Left" Margin="0,12,0,0" Click="GenerateNewGuardian_Click" />

                                <StackPanel x:Name="NewGuardianPanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource H2}" Margin="0,16,0,0" Text="新的监护码 —— 抄给监护人" />
                                    <TextBox x:Name="NewGuardianText" IsReadOnly="True" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}" FontSize="15" Padding="12,10" Height="Auto" MinHeight="48" TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,8" Text="再敲一遍确认" />
                                    <TextBox x:Name="NewGuardianConfirmBox" FontFamily="{StaticResource MonoFont}" />
                                    <Button Content="改监护码" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ChangeGuardian_Click" />
                                </StackPanel>

                                <TextBlock x:Name="ChangeGuardianMessage" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border></Grid>
                    </Grid>
                </Expander>

                <TextBlock x:Name="BackupText" Grid.Row="5" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warning}" />
            </Grid>
        </Grid>

        <!-- 所有面板共用一个消息行：导出/恢复的结果不该因为面板换了就找不到 -->
        <TextBlock x:Name="StatusMessage" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource Hint}" />
        </Grid>

        <Border Grid.Row="2" Height="12" Background="{StaticResource KnotBand}" />
    </Grid>
</Window>
