<Window x:Class="Sentinel.Agent.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel 提醒"
        Icon="Assets/sentinel.ico"
        WindowStyle="None" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FF12141A">
    <Grid Margin="80">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="980">
            <TextBlock x:Name="Headline" FontSize="44" FontWeight="Bold" Foreground="#FF6EA8FF"
                       TextAlignment="Center" TextWrapping="Wrap" Text="Sentinel · 提醒" />

            <TextBlock x:Name="Body" FontSize="22" Foreground="#FFE8E8E8" Margin="0,32,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="36" />

            <Button x:Name="DismissButton" Content="知道了" FontSize="20" Padding="40,14"
                    Margin="0,48,0,0" HorizontalAlignment="Center" Click="Dismiss_Click" />

            <TextBlock x:Name="CountdownText" FontSize="16" Foreground="#FF7A7A7A"
                       Margin="0,20,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
